datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String
  price       Float
  stock       Int
  createdAt   DateTime @default(now())
}

model Appointment {
  id          String   @id @default(cuid())
  clientName  String
  phone       String
  email       String?
  serviceName String
  date        String
  timeSlot    String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}