datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  publishedAt DateTime @default(now())
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  image       String?
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Order {
  id            Int      @id @default(autoincrement())
  customerName  String
  phone         String
  totalAmount   Float
  status        String   @default("PENDING")
  phonePeTxnId  String?
  createdAt     DateTime @default(now())
}